// ---------- Función reutilizable ----------
def runInDocker(String image, Closure body) {
    docker.image(image).inside('-u 0:0') {
        body()
    }
}

pipeline {
    agent any

    environment {
        MAVEN_OPTS = '-Xmx1024m'
    }

    stages {

        stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build: ${env.BUILD_NUMBER}"
            }
        }

        stage('Lint') {
            steps {
                echo "Running Lint (Checkstyle only)..."
                runInDocker('maven:3.8.6-openjdk-11-slim') {
                    sh 'mvn checkstyle:check -q -B || true'
                }
            }
        }

        stage('Test') {
            steps {
                echo "Running unit tests..."
                runInDocker('maven:3.8.6-openjdk-11-slim') {
                    sh 'mvn test -q -B'
                }
                junit 'target/surefire-reports/*.xml'
            }
        }

    }
}
