pipeline {
    agent any

    stages {
        stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build: ${env.BUILD_NUMBER}"
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'maven:3.8.6-openjdk-11-slim'
                }
            }
            steps {
                sh 'mvn test'
            }
        }

        stage('Build Docker') {
            steps {
                sh 'echo "Construir la imagen Docker (sin push)"'
            }
        }

        stage('CD') {
            when { anyOf { branch 'develop'; branch 'master' } }
            steps {
                sh 'echo "Desplegar con Docker Compose en el agente de Jenkins"'
            }
        }
    }
}
